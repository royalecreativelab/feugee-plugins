<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
  Version="6.0"
  ExtensionBundleId="com.feugee.motion"
  ExtensionBundleVersion="1.2.10"
  ExtensionBundleName="Feugee Motion"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.feugee.motion.panel" Version="1.2.10" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[0.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.feugee.motion.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--v=0</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Feugee Motion</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>680</Height>
            </Size>
            <MinSize>
              <Width>220</Width>
              <Height>200</Height>
            </MinSize>
            <MaxSize>
              <Width>2400</Width>
              <Height>2400</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
